# memory | postgres
STORAGE=memory
DATABASE_URL=postgres://bcalendar:bcalendar@localhost:5433/bcalendar
# The old way into the unowned calendars, at /admin. At least 12 characters; unset to retire it.
ADMIN_PASSWORD=change-me-please
# Signs sessions and sign-ins. At least 32 characters.
SESSION_SECRET=change-me-to-32-or-more-random-characters
# Where the site is reached: SSO callbacks go to <PUBLIC_ORIGIN>/v1/auth/<provider>/callback
PUBLIC_ORIGIN=http://localhost:3000
# SSO; a provider shows when both its values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Whoever signs in with this verified email takes over the calendars nobody owns
OWNER_EMAIL=
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://b.johann.no
# Uploaded images
MEDIA_DIR=data/media
# Built web app (apps/web/dist); unset serves the API only
WEB_ROOT=apps/web/dist
HOST=127.0.0.1
PORT=3000
