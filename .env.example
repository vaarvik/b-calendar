# memory | postgres
STORAGE=memory
DATABASE_URL=postgres://bcalendar:bcalendar@localhost:5433/bcalendar
# Logs in to /admin. At least 12 characters.
ADMIN_PASSWORD=change-me-please
# Signs admin sessions. At least 32 characters.
SESSION_SECRET=change-me-to-32-or-more-random-characters
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://b.johann.no
# Uploaded images
MEDIA_DIR=data/media
# Built web app (apps/web/dist); unset serves the API only
WEB_ROOT=apps/web/dist
HOST=127.0.0.1
PORT=3000
